import fckt.io.Console
import fckt.io.Paths.*
import uk.m4xy.cli.Cli
import uk.m4xy.http.server.Server
import uk.m4xy.site.SiteCommand
import uk.m4xy.site.Serving
import uk.m4xy.site.Sites

main(args: List<String>) = Cli.run(SiteCommand.command, args) { options ->
  pages = Sites.build(path(options.source), path(options.out), options.title)
  println("  made ${counted(pages.size)} in ${options.out}")
  options.serve.forEach { port ->
    println("  serving it on http://localhost:$port/, made again as its pages change")
    var made = Sites.changedAt(path(options.source))
    fresh = () -> {
      changed = Sites.changedAt(path(options.source))
      if (changed > made) {
        again = Sites.build(path(options.source), path(options.out), options.title)
        made = changed
        println("  made ${counted(again.size)} again")
      }
      else Unit
    }
    Server.serve(port, Serving.routes(path(options.out), fresh))
  }
}

counted(pages: Int): String = if (pages == 1) "1 page" else "$pages pages"
